{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme": true,
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "overlay",
    "layer-shell": true,
    "layer-shell-cover-screen": true,
    "cssPriority": "user",
    "control-center-margin-top": 10,
    "control-center-margin-bottom": 18,
    "control-center-margin-right": 18,
    "control-center-margin-left": 18,
    "control-center-width": 420,
    "control-center-height": 680,
    "notification-window-width": 380,
    "notification-body-image-height": 120,
    "notification-body-image-width": 320,
    "notification-inline-replies": false,
    "notification-2fa-action": true,
    "notification-grouping": true,
    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,
    "fit-to-screen": false,
    "relative-timestamps": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 180,
    "hide-on-clear": false,
    "hide-on-action": true,
    "text-empty": "All caught up",
    "widgets": ["title", "dnd", "notifications"],
    "widget-config": {
        "title": {"text": "Notifications", "clear-all-button": true, "button-text": "Clear"},
        "dnd": {"text": "Do Not Disturb"},
        "notifications": {"vexpand": true}
    }
}
