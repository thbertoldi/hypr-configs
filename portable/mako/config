sort=-time
layer=overlay
background-color=#1e1e2eff
text-color=#cdd6f4ff
border-size=0
border-radius=10
font=JetBrainsMono NF 11
padding=12
margin=8
max-icon-size=48
default-timeout=5000
ignore-timeout=false
anchor=top-right
width=320
icons=true
markup=true

[urgency=low]
default-timeout=3000

[urgency=normal]
progress-color=over #eba0ac40

[urgency=critical]
default-timeout=0

[grouped]
format=<b>%s</b>\n%b

# Keep the fallback daemon's DND behavior functional too.
[mode=do-not-disturb]
invisible=1
