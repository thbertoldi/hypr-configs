Subject: [PATCH] drm: allow the final disable commit during connector teardown
References: https://github.com/hyprwm/aquamarine/issues/386

The destroy listener disables the CRTC after disconnect() marks the
connector disconnected. Permit that explicit disable through both commit
guards, while rejecting enables, unrelated commits and stale outputs.
Otherwise the kernel retains an orphaned CRTC across HDMI/DP hotplug.

--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -2141,7 +2141,10 @@
 }
 
 bool Aquamarine::SDRMConnector::commitState(SDRMConnectorCommitData& data) {
-    if (status != DRM_MODE_CONNECTED || !output)
+    // disconnect() marks the connector disconnected before the compositor's
+    // destroy callback disables its CRTC. That final disable must reach KMS.
+    const bool DISCONNECT_DISABLE = !data.enabled && (data.committed & COutputState::AQ_OUTPUT_STATE_ENABLED);
+    if (!output || (status != DRM_MODE_CONNECTED && !DISCONNECT_DISABLE))
         return false;
 
     const bool ok = backend->impl->commit(self.lock(), data);
@@ -2494,14 +2497,17 @@
         return false;
     }
 
-    if (connector->status != DRM_MODE_CONNECTED || connector->output != self.lock()) {
-        backend->backend->log(AQ_LOG_ERROR, "drm: Cannot commit a disconnected output");
-        return false;
-    }
-
     const auto     SNAPSHOT  = state->snapshot();
     const auto&    STATE     = SNAPSHOT.state();
     const uint32_t COMMITTED = STATE.committed;
+
+    // The current output may still disable its CRTC from events.destroy after
+    // disconnect() changes status. Keep rejecting enables and stale output objects.
+    const bool DISCONNECT_DISABLE = !STATE.enabled && (COMMITTED & COutputState::AQ_OUTPUT_STATE_ENABLED);
+    if (connector->output != self.lock() || (connector->status != DRM_MODE_CONNECTED && !DISCONNECT_DISABLE)) {
+        backend->backend->log(AQ_LOG_ERROR, "drm: Cannot commit a disconnected output");
+        return false;
+    }
 
     if (SNAPSHOT.error()) {
         backend->backend->log(AQ_LOG_ERROR, std::format("drm: Failed to duplicate explicit input fence: {}", strerror(SNAPSHOT.error())));
